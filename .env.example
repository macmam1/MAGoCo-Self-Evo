# ===== General =====
PROJECT_NAME=MAGoCo-Self-Evo
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===== Backend (FastAPI) =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ===== Database =====
POSTGRES_USER=magoco
POSTGRES_PASSWORD=magoco_dev_password
POSTGRES_DB=magoco
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://magoco:magoco_dev_password@postgres:5432/magoco

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_URL=redis://redis:6379/1

# ===== Auth =====
JWT_SECRET_KEY=change-this-to-a-random-32-char-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Frontend (Vite) =====
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ===== LLM Providers (multi-provider) =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
HUGGINGFACE_HUB_TOKEN=
OLLAMA_BASE_URL=http://ollama:11434

# ===== Storage =====
STORAGE_BACKEND=local  # local | hf_datasets | s3 | gcs
STORAGE_LOCAL_PATH=/app/storage
HF_STORAGE_REPO=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# ===== External Services =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== API Gateway =====
API_GATEWAY_URL=http://kong:8000
KONG_ADMIN_URL=http://kong:8001
