# --- Environment Configuration ---
# Copy this file to .env and fill in your values.
# MAGoCo-Self-Evo runs with SQLite by default (no external DB needed).

# --- LLM Provider ---
# Set either OPENAI_API_KEY (for cloud LLM) or OLLAMA_BASE_URL (for local LLM).
# If both are empty, the engine runs in "simulation mode" (no real LLM).

# OpenAI (Cloud)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Ollama (Local)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# --- Database ---
# Default: SQLite (no setup needed)
# DATABASE_URL=sqlite+aiosqlite:///./magoco.db

# For PostgreSQL (production, optional):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/magoco_db

# --- Application ---
# DEBUG=true
# LOG_LEVEL=INFO

# --- Integration Keys (for services) ---
# Add API keys for services you want to connect via the Integrations Panel.
# SLACK_BOT_TOKEN=xoxb-...
# GITHUB_TOKEN=ghp_...
# NOTION_TOKEN=ntn_...