    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "@tanstack/react-query": "^5.59.20",
    "zustand": "^5.0.1",
    "axios": "^1.7.7",
    "react-hook-form": "^7.53.2",
    "zod": "^3.23.8",
    "@hookform/resolvers": "^3.9.1",
    "i18next": "^24.0.0",
    "react-i18next": "^15.1.1",
    "react-hot-toast": "^2.4.1",
    "lucide-react": "^0.460.0",
    "clsx": "^2.1.1",
